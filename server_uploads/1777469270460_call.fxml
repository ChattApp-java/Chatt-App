<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox alignment="CENTER" spacing="20"
      style="-fx-background-color: #111b21; -fx-padding: 40;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chattapp.client.controller.CallController">

    <Label fx:id="statusLabel" text="Appel en cours…"
           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="32">
        <VBox alignment="CENTER" spacing="8">
            <Label text="Vous" style="-fx-text-fill: #8696a0; -fx-font-size: 13px;"/>
            <ImageView fx:id="localVideo" fitHeight="180" fitWidth="240" preserveRatio="true"/>
        </VBox>
        <VBox alignment="CENTER" spacing="8">
            <Label text="Contact" style="-fx-text-fill: #8696a0; -fx-font-size: 13px;"/>
            <ImageView fx:id="remoteVideo" fitHeight="180" fitWidth="240" preserveRatio="true"/>
        </VBox>
    </HBox>

    <Button onAction="#handleEndCall" text="📵 Raccrocher"
            style="-fx-background-color: #f44336; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-font-weight: bold;
                   -fx-background-radius: 30; -fx-padding: 12 32; -fx-cursor: hand;"/>
</VBox>
