<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            style="-fx-background-color: #090a14;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chattapp.client.controller.MainController">

    <!-- Left sidebar: contact list (programmatic SidebarView injected by controller) -->
    <left>
        <VBox spacing="8"
              style="-fx-padding: 10; -fx-background-color: #0f101e; -fx-min-width: 240; -fx-max-width: 260;">
            <Label text="Contacts"
                   style="-fx-text-fill: #e4e6ff; -fx-font-size: 17px; -fx-font-weight: bold;"/>
            <ListView fx:id="userListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #1e1d34; -fx-text-fill: #e4e6ff;"/>
            <HBox spacing="6">
                <Button onAction="#handleStartChat" text="💬 Chat"
                        style="-fx-background-color: #6c63ff; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleStartCall" text="📞"
                        style="-fx-background-color: #34c759; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button onAction="#handleStartVideoCall" text="📹"
                        style="-fx-background-color: #ff3b30; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </left>

    <!-- Center: chat area injected programmatically -->
    <center>
        <StackPane fx:id="chatContainer"
                   style="-fx-background-color: #090a14;">
            <Label text="Sélectionnez un contact pour discuter"
                   style="-fx-text-fill: #646684; -fx-font-size: 15px;"/>
        </StackPane>
    </center>
</BorderPane>
