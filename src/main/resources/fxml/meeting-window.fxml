<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.tpchatjavafx.client.controller.MeetingController"
           style="-fx-background-color: linear-gradient(to bottom, #5ab2ff, #d8ecff);"
           prefWidth="900" prefHeight="700" minWidth="600" minHeight="500">

    <VBox spacing="0" alignment="TOP_CENTER">

        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: rgba(255,255,255,0.92); -fx-padding: 14 20;
                     -fx-border-color: rgba(23, 103, 194, 0.12); -fx-border-width: 0 0 1 0;">
            <Button style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <FontIcon iconLiteral="fas-chevron-down" iconSize="20" iconColor="#1767c2"/>
                </graphic>
            </Button>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTitle" text="Appel audio de groupe"
                       style="-fx-font-size: 21; -fx-font-weight: bold; -fx-text-fill: #0f3d91;"/>
                <Label fx:id="lblSubtitle" text="En attente..."
                       style="-fx-font-size: 12; -fx-text-fill: #4e6e9d;"/>
            </VBox>
            <Button fx:id="btnAddParticipant" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <FontIcon iconLiteral="fas-user-plus" iconSize="20" iconColor="#1767c2"/>
                </graphic>
            </Button>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: linear-gradient(to bottom, #5ab2ff, #d8ecff);">

            <GridPane fx:id="videoGrid" hgap="10" vgap="10" alignment="CENTER"
                      style="-fx-padding: 20;" visible="false" managed="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="50" halignment="CENTER"/>
                </columnConstraints>
            </GridPane>

            <TilePane fx:id="centerContainer" alignment="TOP_CENTER" prefColumns="2" hgap="18" vgap="18"
                      style="-fx-padding: 28;"/>

        </StackPane>

        <VBox fx:id="bottomControls" alignment="CENTER" spacing="15"
              style="-fx-background-color: rgba(255,255,255,0.90); -fx-padding: 22;
                     -fx-border-color: rgba(23, 103, 194, 0.12); -fx-border-width: 1 0 0 0;">

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="btnMore" prefWidth="56" prefHeight="56"
                        style="-fx-background-color: #253239; -fx-background-radius: 28; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-ellipsis-h" iconSize="24" iconColor="white"/>
                    </graphic>
                </Button>

                <Button fx:id="btnVideo" prefWidth="56" prefHeight="56"
                        style="-fx-background-color: #253239; -fx-background-radius: 28; -fx-cursor: hand;"
                        visible="false" managed="false">
                    <graphic>
                        <FontIcon iconLiteral="fas-video" iconSize="24" iconColor="white"/>
                    </graphic>
                </Button>

                <Button fx:id="btnSpeaker" prefWidth="64" prefHeight="64"
                        style="-fx-background-color: white; -fx-background-radius: 32; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-volume-up" iconSize="28" iconColor="#01579b"/>
                    </graphic>
                </Button>

                <Button fx:id="btnMic" prefWidth="56" prefHeight="56"
                        style="-fx-background-color: #253239; -fx-background-radius: 28; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-microphone" iconSize="24" iconColor="white"/>
                    </graphic>
                </Button>

                <Button fx:id="btnEndCall" prefWidth="56" prefHeight="56"
                        style="-fx-background-color: #ff3b5c; -fx-background-radius: 28; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-phone-slash" iconSize="24" iconColor="white"/>
                    </graphic>
                </Button>
            </HBox>

            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 5 0;">
                <Label text="Plus" prefWidth="56" alignment="CENTER"
                       style="-fx-font-size: 10; -fx-text-fill: #4e6e9d;"/>
                <Label fx:id="lblVideoCaption" text="Video" prefWidth="56" alignment="CENTER"
                       style="-fx-font-size: 10; -fx-text-fill: #4e6e9d;" visible="false" managed="false"/>
                <Label text="Haut-parleur" prefWidth="64" alignment="CENTER"
                       style="-fx-font-size: 10; -fx-text-fill: #4e6e9d;"/>
                <Label text="Micro" prefWidth="56" alignment="CENTER"
                       style="-fx-font-size: 10; -fx-text-fill: #4e6e9d;"/>
                <Label text="Raccrocher" prefWidth="56" alignment="CENTER"
                       style="-fx-font-size: 10; -fx-text-fill: #4e6e9d;"/>
            </HBox>

        </VBox>
    </VBox>

    <ListView fx:id="participantsList" visible="false" managed="false" prefHeight="0" maxHeight="0"/>

</StackPane>
